{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerdangaFactoryCalendar",
  "version": "0.1.0",
  "identifier": "ru.example.graphics",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PerdangaFactoryCalendar",
        "width": 1100,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
